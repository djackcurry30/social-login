# 三方登录统一接入服务 · 环境变量样例
#
# 用法：复制为 .env（.gitignore 已忽略）后按需填写。
# 环境变量优先级【高于】配置文件，因此密钥类配置建议只放这里，不要写进 yaml——
# 配置文件更容易被误提交。
#
# 命名规则：SOCIAL_LOGIN_ + 配置路径（点换下划线、全大写）
#   security.master_key  →  SOCIAL_LOGIN_SECURITY_MASTER_KEY
#   database.dsn         →  SOCIAL_LOGIN_DATABASE_DSN

# ---- 服务 ----
# social_login: "0.0.0.0:443"
# callback_base_url 必须与三方平台后台配置的回调域名完全一致，生产必须是 HTTPS。
# SOCIAL_LOGIN_SERVER_CALLBACK_BASE_URL=https://auth.example.com
# SOCIAL_LOGIN_SERVER_ISSUER=https://auth.example.com
# debug | release。release 会启用一组"生产必须项"强校验（拒绝临时密钥、拒绝 stub 账号、拒绝自动迁移）。
# SOCIAL_LOGIN_SERVER_MODE=release

# ---- 数据库 ----
# SOCIAL_LOGIN_DATABASE_DSN=postgres://user:pass@db:5432/social_login?sslmode=require
# SOCIAL_LOGIN_DATABASE_LOG_SQL=false

# ---- Redis ----
# SOCIAL_LOGIN_CACHE_ADDR=redis:6379
# SOCIAL_LOGIN_CACHE_PASSWORD=

# ---- 密钥（生产必填）----
# 渠道凭据的信封加密主密钥（Base64，32 字节）。用 `make keygen` 生成。
# ⚠️ 必须固定：它与写入 app_provider_configs.secret_cipher 的密文绑定，
#    换掉后所有渠道凭据都无法解密（会明确报错，不会静默返回错误值）。
# SOCIAL_LOGIN_SECURITY_MASTER_KEY=

# 身份凭证哈希盐。⚠️ 必须稳定：变更它会让已入库的 claim 哈希全部无法匹配，
# 即"按手机号/邮箱归并"能力整体失效。
# SOCIAL_LOGIN_SECURITY_CLAIM_SALT=

# 应用密钥哈希盐。
# SOCIAL_LOGIN_SECURITY_APP_SECRET_SALT=

# KMS 密钥版本标识，写入 secret_dek_id，用于轮换时区分密钥版本。
# SOCIAL_LOGIN_SECURITY_KEK_ID=local-kek-v1

# ---- 账号体系 ----
# stub（内存桩，仅开发/测试）| http（真实用户中心，第三期交付）
# SOCIAL_LOGIN_ACCOUNT_PROVIDER=http
# SOCIAL_LOGIN_ACCOUNT_HTTP_BASE_URL=http://user-center.internal
# SOCIAL_LOGIN_ACCOUNT_HTTP_TIMEOUT=3s

# ---- 授权流程 ----
# 用于筛选 app_provider_configs.env
# SOCIAL_LOGIN_AUTH_ENV=prod
# Exchange + UserInfo 的独立超时。它保证"用户断网"不会导致授权码被平台消费却拿不到令牌。
# SOCIAL_LOGIN_AUTH_EXCHANGE_TIMEOUT=5s

# ---- 日志 ----
# debug | info | warn | error
# SOCIAL_LOGIN_LOG_LEVEL=info
# json | console
# SOCIAL_LOGIN_LOG_FORMAT=json
# 留空输出到 stdout；非空则按 lumberjack 规则切割。
# SOCIAL_LOGIN_LOG_FILE=/var/log/social-login/app.log

# ---- 迁移 ----
# ⚠️ 生产必须 false，由发布流程单独执行迁移。
# SOCIAL_LOGIN_MIGRATE_ENABLED=false

# ---- 测试（仅供 test/acceptance 使用）----
# TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/social_login?sslmode=disable
# TEST_REDIS_ADDR=127.0.0.1:6379
